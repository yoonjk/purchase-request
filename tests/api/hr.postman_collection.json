{
  "info": {
    "name": "HR API",
    "description": "HR: 직원 목록/등록/수정, 연차 조회/신청/수정/취소, 입력 검증, 인증/CSRF",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('empId')) {",
          "  pm.collectionVariables.set('empId', ('NM' + Date.now().toString(36).toUpperCase()).slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Unauthenticated",
      "description": "로그인 전 요청. 세션이 없으므로 /api 는 401, CSRF 없는 변경 요청은 403.",
      "item": [
        {
          "name": "[HR-API-01] 비인증 GET /api/hr/employees → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hr/employees"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "[HR-API-02] 비인증 POST /api/hr/employees (CSRF 없음) → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/hr/employees",
            "body": {
              "mode": "raw",
              "raw": "{\"employeeId\":\"{{empId}}\",\"name\":\"NM 테스터\",\"department\":\"QA\",\"managerId\":null,\"annualLeaveDays\":10}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth Setup",
      "description": "세션 쿠키(JSESSIONID, XSRF-TOKEN)는 Newman cookie jar 가 유지한다. 토큰/쿠키는 리포트에 기록하지 않는다.",
      "item": [
        {
          "name": "[HR-API-S1] CSRF 토큰 발급 (permitAll)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('headerName=X-XSRF-TOKEN', () => pm.expect(j.headerName).to.eql('X-XSRF-TOKEN'));",
                  "pm.test('token 존재', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('csrfToken', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "[HR-API-S2] 잘못된 비밀번호 로그인 → /login.html?error 로 redirect",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{loginId}}"
                },
                {
                  "key": "password",
                  "value": "intentionally-wrong-password-12345"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 302', () => pm.response.to.have.status(302));",
                  "pm.test('Location 에 error 포함', () => pm.expect(pm.response.headers.get('Location')).to.include('/login.html?error'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "[HR-API-S3] 정상 로그인 → /dashboard.html 로 redirect",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{loginId}}"
                },
                {
                  "key": "password",
                  "value": "{{loginPassword}}"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 302', () => pm.response.to.have.status(302));",
                  "pm.test('Location 에 dashboard.html 포함', () => pm.expect(pm.response.headers.get('Location')).to.include('/dashboard.html'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "[HR-API-S4] 로그인 후 CSRF 토큰 재발급",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', j.token);",
                  "pm.test('token 갱신', () => pm.expect(j.token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "[HR-API-S5] 인증 확인 GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('loginId 반환', () => pm.expect(j.loginId).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 CSRF Security",
