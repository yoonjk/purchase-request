            ],
            "url": "{{baseUrl}}/api/hr/employees",
            "body": {
              "mode": "raw",
              "raw": "{\"employeeId\":\"{{empId}}\",\"name\":\"NM 테스터\",\"department\":\"QA\",\"managerId\":null,\"annualLeaveDays\":10}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Read (no DB change)",
      "item": [
        {
          "name": "[HR-API-01] 직원 목록 조회 → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/hr/employees"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('배열', () => pm.expect(j).to.be.an('array'));",
                  "pm.test('직원 필드', () => { if (j.length) ['employeeId','name','department','annualLeaveDays','usedLeaveDays'].forEach(k => pm.expect(j[0]).to.have.property(k)); });",
                  "pm.test('사용 연차 ≤ 총 연차', () => j.forEach(e => pm.expect(e.usedLeaveDays).to.be.at.most(e.annualLeaveDays)));"
                ]
              }
            }
          ]
        },
        {
          "name": "[HR-API-02] 존재하지 않는 직원 조회 → 404",
