    {
      "name": "[MUTATION] 04 Create, Lookup, List & Approval rules",
      "description": "구매 요청은 삭제 API 가 없으므로 {{runId}} 로 식별되는 데이터가 남는다.",
      "item": [
        {
          "name": "[PUR-API-15] 구매 요청 등록 amount=500000, budget=1000000 → AUTO_APPROVED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/purchase-requests",
            "body": {
              "mode": "raw",
              "raw": "{\"requester\":\"nm-tester\",\"test_run_id\":\"{{runId}}\",\"amount\":500000,\"budget\":1000000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('status=AUTO_APPROVED', () => pm.expect(j.status).to.eql('AUTO_APPROVED'));",
                  "pm.test('echo test_run_id', () => pm.expect(j.test_run_id).to.eql(pm.collectionVariables.get('runId')));",
                  "pm.test('amount/budget 일치', () => { pm.expect(Number(j.amount)).to.eql(500000); pm.expect(Number(j.budget)).to.eql(1000000); });",
                  "pm.test('request_id > 0', () => pm.expect(j.request_id).to.be.above(0));",
                  "pm.collectionVariables.set('createdId', j.request_id);"
                ]
              }
            }
          ]
        },
        {
