{
  "info": {
    "name": "Purchase API",
    "description": "PURCHASE: 구매 요청 등록/조회/목록, 입력 검증, 승인 규칙, 인증/CSRF",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', 'NM-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Unauthenticated",
      "description": "로그인 전 요청. 세션이 없으므로 /api 는 401, CSRF 없는 변경 요청은 403.",
      "item": [
        {
          "name": "[PUR-API-01] 비인증 GET /api/purchase-requests → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/purchase-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "[PUR-API-02] 비인증 POST /api/purchase-requests (CSRF 없음) → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/purchase-requests",
            "body": {
              "mode": "raw",
              "raw": "{\"requester\":\"nm-tester\",\"test_run_id\":\"{{runId}}\",\"amount\":1000,\"budget\":2000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth Setup",
      "description": "세션 쿠키(JSESSIONID, XSRF-TOKEN)는 Newman cookie jar 가 유지한다. 토큰/쿠키는 리포트에 기록하지 않는다.",
      "item": [
        {
          "name": "[PUR-API-S1] CSRF 토큰 발급 (permitAll)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('headerName=X-XSRF-TOKEN', () => pm.expect(j.headerName).to.eql('X-XSRF-TOKEN'));",
                  "pm.test('token 존재', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('csrfToken', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "[PUR-API-S2] 잘못된 비밀번호 로그인 → /login.html?error 로 redirect",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{loginId}}"
                },
                {
                  "key": "password",
                  "value": "intentionally-wrong-password-12345"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 302', () => pm.response.to.have.status(302));",
                  "pm.test('Location 에 error 포함', () => pm.expect(pm.response.headers.get('Location')).to.include('/login.html?error'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "[PUR-API-S3] 정상 로그인 → /dashboard.html 로 redirect",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{loginId}}"
                },
                {
                  "key": "password",
                  "value": "{{loginPassword}}"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrfToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 302', () => pm.response.to.have.status(302));",
                  "pm.test('Location 에 dashboard.html 포함', () => pm.expect(pm.response.headers.get('Location')).to.include('/dashboard.html'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "[PUR-API-S4] 로그인 후 CSRF 토큰 재발급",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', j.token);",
                  "pm.test('token 갱신', () => pm.expect(j.token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "[PUR-API-S5] 인증 확인 GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('loginId 반환', () => pm.expect(j.loginId).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
