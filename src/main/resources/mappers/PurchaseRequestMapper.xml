<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.purchase.dao.PurchaseRequestMapper">
  <resultMap id="purchaseMap" type="com.demo.purchase.dao.vo.PurchaseRequest">
    <id column="request_id" property="requestId"/>
    <result column="requester" property="requester"/>
    <result column="test_run_id" property="testRunId"/>
    <result column="total_amount" property="totalAmount"/>
    <result column="budget" property="budget"/>
    <result column="status" property="status"/>
  </resultMap>
  <insert id="insert" parameterType="com.demo.purchase.dao.vo.PurchaseRequest" useGeneratedKeys="true" keyProperty="requestId" keyColumn="request_id">
    INSERT INTO test_purchase_requests (test_run_id, requester, total_amount, budget, status)
    VALUES (#{testRunId}, #{requester}, #{totalAmount}, #{budget}, #{status})
  </insert>
  <select id="findByIdAndRunId" resultMap="purchaseMap">
    SELECT request_id, requester, test_run_id, total_amount, budget, status
    FROM test_purchase_requests
    WHERE request_id = #{requestId} AND test_run_id = #{testRunId}
  </select>
</mapper>
